<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 键名输入 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="键名"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/key_edit_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="请输入键名"
                android:singleLine="true" />
        </LinearLayout>

        <!-- 数据类型选择 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="数据类型"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/type_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 值输入区域 - 根据数据类型动态显示不同控件 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="值"
                android:textStyle="bold" />

            <!-- String类型输入 -->
            <EditText
                android:id="@+id/string_value_edit_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="请输入文本值"
                android:inputType="textMultiLine"
                android:maxLines="5"
                android:textSize="12sp" />

            <!-- Integer类型输入 -->
            <LinearLayout
                android:id="@+id/integer_value_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/integer_value_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="请输入整数值"
                    android:inputType="numberSigned"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/integer_error_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="请输入有效的整数"
                    android:textColor="#F44336"
                    android:textSize="12sp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Long类型输入 -->
            <LinearLayout
                android:id="@+id/long_value_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/long_value_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="请输入长整数值"
                    android:inputType="numberSigned"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/long_error_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="请输入有效的长整数"
                    android:textColor="#F44336"
                    android:textSize="12sp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Float类型输入 -->
            <LinearLayout
                android:id="@+id/float_value_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/float_value_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="请输入浮点数值"
                    android:inputType="numberSigned|numberDecimal"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/float_error_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="请输入有效的浮点数"
                    android:textColor="#F44336"
                    android:textSize="12sp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Boolean类型输入 -->

            <RadioGroup
                android:id="@+id/boolean_value_radio_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <RadioButton
                    android:id="@+id/boolean_true_radio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/radio_button_background"
                    android:button="@null"
                    android:buttonTint="#4CAF50"
                    android:checked="true"
                    android:gravity="center"
                    android:padding="12dp"
                    android:text="✓ true"
                    android:textColor="#4CAF50" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <RadioButton
                    android:id="@+id/boolean_false_radio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/radio_button_background"
                    android:button="@null"
                    android:buttonTint="#F44336"
                    android:gravity="center"
                    android:padding="12dp"
                    android:text="✗ false"
                    android:textColor="#F44336" />

            </RadioGroup>

            <!-- StringSet类型输入 -->
            <LinearLayout
                android:id="@+id/string_set_value_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/string_set_item_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="输入单个值，用逗号分隔多个值"
                    android:inputType="textMultiLine"
                    android:maxLines="3"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="提示: 使用逗号分隔多个值"
                    android:textColor="#999999"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 按钮区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/cancel_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:text="取消" />

            <Button
                android:id="@+id/save_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="保存" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>